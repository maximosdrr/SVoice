<Page
    x:Class="SVoice.GameBar.WidgetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="HeaderIconButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#12FFFFFF" />
            <Setter Property="BorderBrush" Value="#18FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="100" />
            <Setter Property="Foreground" Value="#B0FFFFFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SmallLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="#80FFFFFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="#C8FFFFFF" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="CompactButton" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid" Padding="8" Background="Transparent">
        <Border
            x:Name="Surface"
            Background="#F20B1119"
            BorderBrush="#28FFFFFF"
            BorderThickness="1"
            CornerRadius="18" />

        <Grid Padding="14,11,14,11">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="26" Height="26" Background="#FF8BE9D2" CornerRadius="8">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Segoe UI Symbol"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#FF091016"
                        Text="≋" />
                </Border>

                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="11.5"
                    FontWeight="Bold"
                    CharacterSpacing="150"
                    Text="SVOICE" />

                <Ellipse
                    x:Name="StatusDot"
                    Grid.Column="4"
                    Width="6"
                    Height="6"
                    VerticalAlignment="Center"
                    Fill="#FF8BE9D2" />

                <TextBlock
                    x:Name="StatusText"
                    Grid.Column="5"
                    Margin="6,0,6,0"
                    VerticalAlignment="Center"
                    FontSize="9"
                    FontWeight="Bold"
                    Foreground="#D98BE9D2"
                    CharacterSpacing="80"
                    TextTrimming="CharacterEllipsis"
                    Text="INICIANDO" />

                <Border
                    Grid.Column="6"
                    Padding="7,4"
                    Background="#12FFFFFF"
                    BorderBrush="#18FFFFFF"
                    BorderThickness="1"
                    CornerRadius="8"
                    ToolTipService.ToolTip="Dispositivo de saída usado para a voz">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon
                            x:Name="OutputIcon"
                            Margin="0,0,5,0"
                            FontSize="10"
                            Foreground="#FFFFC776"
                            Glyph="&#xE720;" />
                        <TextBlock
                            x:Name="OutputText"
                            FontSize="9"
                            Foreground="#AFFFFFFF"
                            Text="PROCURANDO SAÍDA" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="4">
                    <Button
                        x:Name="HistoryButton"
                        Style="{StaticResource HeaderIconButton}"
                        Click="HistoryButton_Click"
                        ToolTipService.ToolTip="Histórico de frases">
                        <FontIcon FontSize="11" Glyph="&#xE81C;" />
                    </Button>
                    <Button
                        x:Name="VoicesButton"
                        Style="{StaticResource HeaderIconButton}"
                        Click="VoicesButton_Click"
                        ToolTipService.ToolTip="Gerenciar vozes clonadas">
                        <FontIcon FontSize="11" Glyph="&#xE77B;" />
                    </Button>
                    <Button
                        x:Name="SettingsButton"
                        Style="{StaticResource HeaderIconButton}"
                        Click="SettingsButton_Click"
                        ToolTipService.ToolTip="Ajustes">
                        <FontIcon FontSize="11" Glyph="&#xE713;" />
                    </Button>
                    <Button
                        x:Name="DiagnosticsButton"
                        Style="{StaticResource HeaderIconButton}"
                        Click="DiagnosticsButton_Click"
                        ToolTipService.ToolTip="Diagnóstico do XTTS e da GPU">
                        <FontIcon FontSize="11" Glyph="&#xE9D9;" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main view -->
            <Grid x:Name="MainView" Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="7" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Height="48"
                    Background="#38000000"
                    BorderBrush="#20FFFFFF"
                    BorderThickness="1"
                    CornerRadius="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            x:Name="MessageBox"
                            Margin="4,2,2,2"
                            Padding="10,8"
                            VerticalContentAlignment="Center"
                            AcceptsReturn="False"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            KeyDown="Composer_KeyDown"
                            MaxLength="1000"
                            PlaceholderText="Escreva o que você quer dizer…"
                            TextWrapping="NoWrap" />

                        <Button
                            x:Name="SpeakButton"
                            Grid.Column="1"
                            Width="34"
                            Height="34"
                            Margin="3,0,6,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#268BE9D2"
                            BorderBrush="#408BE9D2"
                            BorderThickness="1"
                            Click="SpeakButton_Click"
                            CornerRadius="11"
                            ToolTipService.ToolTip="Falar (Enter) / Parar (Esc)">
                            <FontIcon
                                x:Name="SpeakIcon"
                                FontSize="14"
                                Foreground="#FF8BE9D2"
                                Glyph="&#xE74A;" />
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="9"
                        FontWeight="Bold"
                        Foreground="#70FFFFFF"
                        CharacterSpacing="100"
                        Text="VOZ" />

                    <ComboBox
                        x:Name="VoiceBox"
                        Grid.Column="2"
                        MinWidth="120"
                        Height="28"
                        HorizontalAlignment="Stretch"
                        Padding="8,1"
                        FontSize="10"
                        SelectionChanged="VoiceBox_SelectionChanged" />

                    <Button
                        x:Name="CloneVoiceButton"
                        Grid.Column="4"
                        Style="{StaticResource CompactButton}"
                        Click="CloneVoiceButton_Click"
                        ToolTipService.ToolTip="Criar uma voz clonada com áudios de referência">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Margin="0,0,5,0" FontSize="11" Glyph="&#xE8D4;" />
                            <TextBlock VerticalAlignment="Center" FontSize="9" FontWeight="SemiBold" Text="CLONAR" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="RefreshVoicesButton"
                        Grid.Column="6"
                        Width="28"
                        Height="26"
                        Padding="0"
                        CornerRadius="8"
                        Click="RefreshVoicesButton_Click"
                        ToolTipService.ToolTip="Atualizar vozes e reconectar ao XTTS">
                        <FontIcon FontSize="11" Glyph="&#xE72C;" />
                    </Button>
                </Grid>

                <StackPanel Grid.Row="4" Spacing="4">
                    <ProgressBar
                        x:Name="JobProgress"
                        Height="3"
                        Foreground="#FFBFA6FF"
                        IsIndeterminate="True"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="JobMessage"
                        FontSize="9.5"
                        Foreground="#9FBFA6FF"
                        TextTrimming="CharacterEllipsis"
                        Visibility="Collapsed" />
                    <Border
                        x:Name="ErrorPanel"
                        Padding="9,6"
                        Background="#26FF7C87"
                        BorderBrush="#40FF7C87"
                        BorderThickness="1"
                        CornerRadius="9"
                        Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="1">
                                <TextBlock
                                    x:Name="ErrorText"
                                    FontSize="10"
                                    Foreground="#FFFFB3B9"
                                    TextWrapping="Wrap"
                                    MaxLines="2"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="ErrorAction"
                                    FontSize="9.5"
                                    Foreground="#B8FFFFFF"
                                    TextWrapping="Wrap"
                                    MaxLines="2"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="Collapsed" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Width="22"
                                Height="22"
                                Margin="6,0,0,0"
                                Padding="0"
                                VerticalAlignment="Top"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="DismissError_Click">
                                <FontIcon FontSize="9" Glyph="&#xE711;" />
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>

                <Border
                    x:Name="LastPhrasePanel"
                    Grid.Row="5"
                    Margin="0,6,0,0"
                    Padding="10,6"
                    VerticalAlignment="Top"
                    Background="#0DFFFFFF"
                    CornerRadius="10"
                    Visibility="Collapsed"
                    ToolTipService.ToolTip="Clique para repetir a última frase">
                    <Button
                        x:Name="RepeatLastButton"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="RepeatLastButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" FontSize="11" Foreground="#8A8BE9D2" Glyph="&#xE8EE;" />
                            <TextBlock
                                x:Name="LastPhraseText"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="10"
                                Foreground="#8FFFFFFF"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Button>
                </Border>

                <Grid Grid.Row="6" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        x:Name="HintText"
                        VerticalAlignment="Center"
                        FontSize="9.5"
                        Foreground="#65FFFFFF"
                        TextTrimming="CharacterEllipsis"
                        Text="Enter: falar  •  Esc: parar" />

                    <TextBlock
                        x:Name="BackendBadge"
                        Grid.Column="1"
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        FontSize="9"
                        Foreground="#70FFFFFF"
                        Text="" />

                    <ToggleButton
                        x:Name="EchoButton"
                        Grid.Column="3"
                        MinWidth="60"
                        Height="26"
                        Padding="8,2"
                        CornerRadius="8"
                        Click="EchoButton_Click"
                        IsEnabled="False"
                        ToolTipService.ToolTip="Ouvir também na saída padrão do Windows (só com o VB-CABLE)">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Margin="0,0,5,0" FontSize="11" Glyph="&#xE767;" />
                            <TextBlock VerticalAlignment="Center" FontSize="9" FontWeight="SemiBold" Text="ECO" />
                        </StackPanel>
                    </ToggleButton>
                </Grid>
            </Grid>

            <!-- Secondary panels -->
            <Grid x:Name="PanelView" Grid.Row="2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Style="{StaticResource HeaderIconButton}"
                        Click="ClosePanel_Click"
                        ToolTipService.ToolTip="Voltar">
                        <FontIcon FontSize="11" Glyph="&#xE72B;" />
                    </Button>
                    <TextBlock x:Name="PanelTitleText" Grid.Column="2" Style="{StaticResource PanelTitle}" Text="PAINEL" />
                    <Button
                        x:Name="PanelActionButton"
                        Grid.Column="3"
                        Style="{StaticResource CompactButton}"
                        Click="PanelAction_Click"
                        Visibility="Collapsed">
                        <TextBlock x:Name="PanelActionText" FontSize="9" FontWeight="SemiBold" Text="AÇÃO" />
                    </Button>
                </Grid>

                <ScrollViewer
                    Grid.Row="2"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <!-- History -->
                        <StackPanel x:Name="HistoryPanel" Spacing="4" Visibility="Collapsed">
                            <TextBlock
                                x:Name="HistoryEmptyText"
                                Style="{StaticResource SmallLabel}"
                                Text="Nenhuma frase falada ainda." />
                            <ItemsControl x:Name="HistoryList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            Margin="0,0,0,4"
                                            Padding="9,5"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Background="#0DFFFFFF"
                                            BorderThickness="0"
                                            CornerRadius="9"
                                            Click="HistoryItem_Click"
                                            Tag="{Binding}">
                                            <TextBlock FontSize="10.5" Foreground="#C8FFFFFF" MaxLines="2" Text="{Binding}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Voices -->
                        <StackPanel x:Name="VoicesPanel" Spacing="4" Visibility="Collapsed">
                            <TextBlock
                                x:Name="VoicesEmptyText"
                                Style="{StaticResource SmallLabel}"
                                Text="Nenhuma voz clonada. Use CLONAR na tela principal." />
                            <ItemsControl x:Name="VoicesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,0,4"
                                            Padding="9,5"
                                            Background="#0DFFFFFF"
                                            CornerRadius="9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock FontSize="10.5" Foreground="#E0FFFFFF" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontSize="9" Foreground="#80FFFFFF" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="1"
                                                    Width="26"
                                                    Height="24"
                                                    Margin="6,0,0,0"
                                                    Padding="0"
                                                    Click="RenameVoice_Click"
                                                    Tag="{Binding}"
                                                    ToolTipService.ToolTip="Renomear">
                                                    <FontIcon FontSize="10" Glyph="&#xE70F;" />
                                                </Button>
                                                <Button
                                                    Grid.Column="2"
                                                    Width="26"
                                                    Height="24"
                                                    Margin="4,0,0,0"
                                                    Padding="0"
                                                    Click="DeleteVoice_Click"
                                                    Tag="{Binding}"
                                                    ToolTipService.ToolTip="Excluir">
                                                    <FontIcon FontSize="10" Foreground="#FFFF9AA2" Glyph="&#xE74D;" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Settings -->
                        <StackPanel x:Name="SettingsPanel" Spacing="6" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SmallLabel}" Text="Processamento" />
                                <ComboBox
                                    x:Name="ComputeModeBox"
                                    Grid.Column="1"
                                    Height="28"
                                    HorizontalAlignment="Stretch"
                                    FontSize="10"
                                    SelectionChanged="ComputeModeBox_SelectionChanged" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SmallLabel}" Text="Saída de áudio" />
                                <ComboBox
                                    x:Name="OutputDeviceBox"
                                    Grid.Column="1"
                                    Height="28"
                                    HorizontalAlignment="Stretch"
                                    FontSize="10"
                                    SelectionChanged="OutputDeviceBox_SelectionChanged" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SmallLabel}" Text="Velocidade" />
                                <Slider
                                    x:Name="SpeedSlider"
                                    Grid.Column="1"
                                    Margin="0,-4,8,0"
                                    ValueChanged="SpeedSlider_ValueChanged" />
                                <TextBlock x:Name="SpeedValueText" Grid.Column="2" Style="{StaticResource SmallLabel}" Text="1,00×" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SmallLabel}" Text="Volume" />
                                <Slider
                                    x:Name="VolumeSlider"
                                    Grid.Column="1"
                                    Margin="0,-4,8,0"
                                    ValueChanged="VolumeSlider_ValueChanged" />
                                <TextBlock x:Name="VolumeValueText" Grid.Column="2" Style="{StaticResource SmallLabel}" Text="100%" />
                            </Grid>
                            <Border Padding="9,6" Background="#0DFFFFFF" CornerRadius="9">
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="Usar no Discord" />
                                    <TextBlock Style="{StaticResource SmallLabel}" Text="A voz é enviada para CABLE Input. No Discord, em Configurações › Voz e vídeo, escolha CABLE Output como microfone. Ative ECO para ouvir a fala nos seus fones." />
                                    <TextBlock Style="{StaticResource SmallLabel}" Text="VB-CABLE é um donationware da VB-Audio Software (vb-cable.com)." />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Diagnostics -->
                        <StackPanel x:Name="DiagnosticsPanel" Spacing="5" Visibility="Collapsed">
                            <TextBlock x:Name="DiagnosticsSummary" Style="{StaticResource BodyText}" Text="Consultando o mecanismo XTTS…" />
                            <ItemsControl x:Name="DiagnosticsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="128" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="9.5" Foreground="#80FFFFFF" Text="{Binding Label}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" FontSize="9.5" Foreground="#D0FFFFFF" IsTextSelectionEnabled="True" Text="{Binding Value}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ComboBox x:Name="TestBackendBox" Height="28" MinWidth="120" FontSize="10" />
                                <Button x:Name="TestBackendButton" Style="{StaticResource CompactButton}" Click="TestBackend_Click">
                                    <TextBlock FontSize="9" FontWeight="SemiBold" Text="TESTAR BACKEND" />
                                </Button>
                                <Button x:Name="RestartServiceButton" Style="{StaticResource CompactButton}" Click="RestartService_Click">
                                    <TextBlock FontSize="9" FontWeight="SemiBold" Text="RECONECTAR" />
                                </Button>
                                <Button x:Name="EnsureModelButton" Style="{StaticResource CompactButton}" Click="EnsureModel_Click">
                                    <TextBlock FontSize="9" FontWeight="SemiBold" Text="VERIFICAR MODELO" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
