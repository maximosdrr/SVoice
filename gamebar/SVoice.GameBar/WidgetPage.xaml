<Page
    x:Class="SVoice.GameBar.WidgetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Padding="8" Background="Transparent">
        <Border
            x:Name="Surface"
            Background="#F20B1119"
            BorderBrush="#28FFFFFF"
            BorderThickness="1"
            CornerRadius="18" />

        <Grid Padding="15,12,15,13">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="9" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="28"
                    Height="28"
                    Background="#FF8BE9D2"
                    CornerRadius="9">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Segoe UI Symbol"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="#FF091016"
                        Text="≋" />
                </Border>

                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="Bold"
                    CharacterSpacing="150"
                    Text="SVOICE" />

                <Ellipse
                    x:Name="StatusDot"
                    Grid.Column="4"
                    Width="6"
                    Height="6"
                    VerticalAlignment="Center"
                    Fill="#FF8BE9D2" />

                <TextBlock
                    x:Name="StatusText"
                    Grid.Column="5"
                    Margin="7,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="9"
                    FontWeight="Bold"
                    Foreground="#D98BE9D2"
                    CharacterSpacing="100"
                    Text="INICIANDO" />

                <Border
                    Grid.Column="6"
                    Padding="8,4"
                    Background="#12FFFFFF"
                    BorderBrush="#18FFFFFF"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon
                            x:Name="OutputIcon"
                            Margin="0,0,5,0"
                            FontSize="10"
                            Foreground="#FFFFC776"
                            Glyph="&#xE720;" />
                        <TextBlock
                            x:Name="OutputText"
                            FontSize="9"
                            Foreground="#AFFFFFFF"
                            Text="PROCURANDO SAÍDA" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border
                Grid.Row="2"
                Height="52"
                Background="#38000000"
                BorderBrush="#20FFFFFF"
                BorderThickness="1"
                CornerRadius="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        x:Name="MessageBox"
                        Margin="4,2,2,2"
                        Padding="10,10"
                        VerticalContentAlignment="Center"
                        AcceptsReturn="False"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="13"
                        KeyDown="Composer_KeyDown"
                        MaxLength="500"
                        PlaceholderText="Escreva o que você quer dizer…"
                        TextWrapping="NoWrap" />

                    <Button
                        x:Name="SpeakButton"
                        Grid.Column="1"
                        Width="38"
                        Height="38"
                        Margin="3,0,7,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#268BE9D2"
                        BorderBrush="#408BE9D2"
                        BorderThickness="1"
                        Click="SpeakButton_Click"
                        CornerRadius="12">
                        <FontIcon
                            FontSize="15"
                            Foreground="#FF8BE9D2"
                            Glyph="&#xE74A;" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="9"
                    FontWeight="Bold"
                    Foreground="#70FFFFFF"
                    CharacterSpacing="100"
                    Text="VOZ" />

                <ComboBox
                    x:Name="VoiceBox"
                    Grid.Column="2"
                    MinWidth="120"
                    Height="30"
                    Padding="8,1"
                    FontSize="10"
                    SelectionChanged="VoiceBox_SelectionChanged" />

                <Button
                    x:Name="CloneVoiceButton"
                    Grid.Column="4"
                    Height="30"
                    Padding="8,1"
                    Click="CloneVoiceButton_Click"
                    ToolTipService.ToolTip="Criar uma voz clonada com áudios de referência">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon Margin="0,0,5,0" FontSize="11" Glyph="&#xE8D4;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="9"
                            FontWeight="SemiBold"
                            Text="CLONAR" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="RefreshVoicesButton"
                    Grid.Column="6"
                    Width="30"
                    Height="30"
                    Padding="0"
                    Click="RefreshVoicesButton_Click"
                    ToolTipService.ToolTip="Atualizar vozes clonadas">
                    <FontIcon FontSize="11" Glyph="&#xE72C;" />
                </Button>
            </Grid>

            <Border
                x:Name="HistoryPanel"
                Grid.Row="6"
                Padding="10,7"
                Background="#0DFFFFFF"
                CornerRadius="10"
                Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="#8A8BE9D2"
                        Glyph="&#xE72C;" />
                    <TextBlock
                        x:Name="HistoryText"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontSize="10"
                        Foreground="#8FFFFFFF"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <Grid Grid.Row="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="9.5"
                    Foreground="#65FFFFFF"
                    Text="Enter: falar  •  Esc: parar" />

                <ToggleButton
                    x:Name="EchoButton"
                    Grid.Column="1"
                    MinWidth="62"
                    Height="26"
                    Padding="8,2"
                    Click="EchoButton_Click"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Ouvir também na saída padrão do Windows">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon
                            Margin="0,0,5,0"
                            FontSize="11"
                            Glyph="&#xE767;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="9"
                            FontWeight="SemiBold"
                            Text="ECO" />
                    </StackPanel>
                </ToggleButton>
            </Grid>
        </Grid>
    </Grid>
</Page>
