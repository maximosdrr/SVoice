<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseUwp>true</UseUwp>
    <Platforms>x64</Platforms>
    <UseRidGraph>true</UseRidGraph>
    <DefaultLanguage>pt-BR</DefaultLanguage>
    <RootNamespace>SVoice.GameBar</RootNamespace>
    <AssemblyName>SVoice.GameBar</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>enable</Nullable>
    <PublishAot>false</PublishAot>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <AppxAutoIncrementPackageRevision>false</AppxAutoIncrementPackageRevision>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <GenerateTestArtifacts>true</GenerateTestArtifacts>
    <AppxBundle>Never</AppxBundle>
    <AssetTargetFallback>$(AssetTargetFallback);uap10.0</AssetTargetFallback>
    <XboxGameBarSdkVersion>7.3.2607010</XboxGameBarSdkVersion>
    <CsWinRTIncludes>Microsoft.Gaming.XboxGameBar</CsWinRTIncludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Gaming.XboxGameBar" Version="$(XboxGameBarSdkVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />
    <CsWinRTInputs Include="$(NuGetPackageRoot)microsoft.gaming.xboxgamebar\$(XboxGameBarSdkVersion)\lib\uap10.0\Microsoft.Gaming.XboxGameBar.winmd" />
    <Content Include="$(NuGetPackageRoot)microsoft.gaming.xboxgamebar\$(XboxGameBarSdkVersion)\runtimes\win10-x64\native\Microsoft.Gaming.XboxGameBar.dll">
      <Link>Microsoft.Gaming.XboxGameBar.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(NuGetPackageRoot)microsoft.gaming.xboxgamebar\$(XboxGameBarSdkVersion)\lib\uap10.0\Microsoft.Gaming.XboxGameBar.winmd">
      <Link>Microsoft.Gaming.XboxGameBar.winmd</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(NuGetPackageRoot)microsoft.gaming.xboxgamebar\$(XboxGameBarSdkVersion)\private\Microsoft.Gaming.XboxGameBar.Private.winmd">
      <Link>Microsoft.Gaming.XboxGameBar.Private.winmd</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Bridge\**\*" Exclude="Bridge\**\*.pdb">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="GameBar\README.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
